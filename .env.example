# ReadAble Environment Variables

# API Settings
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Authentication
JWT_SECRET=readable-secret-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/readable_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/readable_test_db

# File Storage Settings
STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=50

# Public Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
